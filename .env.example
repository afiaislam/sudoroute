# Copy this file to .env and paste your key. .env is git-ignored — never commit your key.
GEMINI_API_KEY=paste-your-gemini-api-key-here

# Optional: force a specific model (default tries gemini-3.1-flash-lite, then newer fallbacks)
# TS_LLM_MODEL=gemini-3.1-flash-lite

# Optional: fixed signing secret so proposals survive a restart
# TS_SECRET=change-me-to-a-long-random-string
